{
  "name": "@bugflow/extension",
  "version": "0.0.0",
  "private": true,
  "description": "Extension Chrome BugFlow — React + Vite + Manifest V3.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "echo \"(extension) no tests yet\" && exit 0"
  },
  "dependencies": {
    "@bugflow/shared": "workspace:*",
    "@bugflow/types": "workspace:*",
    "@bugflow/ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.26",
    "@types/chrome": "^0.0.277",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^6.4.5"
  }
}
