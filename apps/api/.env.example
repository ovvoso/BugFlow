# Base de données PostgreSQL
DATABASE_URL="postgresql://bugflow:bugflow@localhost:5432/bugflow?schema=public"

# Serveur
PORT=3000
NODE_ENV=development

# Origine du dashboard autorisée par le CORS (credentials)
DASHBOARD_ORIGIN=http://localhost:5173

# Secrets JWT (générer des valeurs aléatoires fortes en production)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d



# 1. Construire l'extension                                                                                                                                                   
                                                                                                                                                                              
#   pnpm --filter @bugflow/extension build                                                                                                                                      
#   Ça produit apps/extension/dist.

#   2. Charger l'extension dans Chrome

#   1. Ouvre chrome://extensions
#   2. Active Mode développeur (interrupteur en haut à droite)
#   3. Clique Charger l'extension non empaquetée
#   4. Sélectionne le dossier C:\dev\bugflow\apps\extension\dist
#   5. Épingle BugFlow dans la barre d'outils (icône puzzle → épingle)

#   À chaque rebuild, reviens sur chrome://extensions et clique l'icône recharger (↻) sur la carte BugFlow.

#   3. Démarrer l'API (nécessaire : la capture est dans la vue connectée)

#   Dans un terminal, à la racine :
#   pnpm dev
#   (attends Auth running on port 3000)

#   4. Tester le parcours

#   1. Clique l'icône BugFlow → le popup s'ouvre
#   2. Connecte-toi (test@bugflow.dev / Test1234, ou ton compte)
#   3. Va sur une page web normale (ex. https://example.com — pas une page chrome://)
#   4. Rouvre le popup → clique « Capturer la zone visible » → l'aperçu doit s'afficher
#   5. Ferme puis rouvre le popup → l'aperçu est toujours là (stockage session)
#   6. Clique « Effacer la capture » → l'aperçu disparaît
#   7. Bonus : sur une page chrome://extensions, tente une capture → message d'erreur lisible (page non capturable)

#   5. Si tout est bon — git (à taper toi-même)

#   git checkout -b feat/extension-capture-ecran
#   git add -A
#   git status        # vérifie qu'aucun .env n'apparaît
#   git commit -m "$(cat <<'EOF'
#   feat(extension): capture de la zone visible (étape 3)

#   - manifest: permissions activeTab + tabs (scripting non requis pour la zone visible)
#   - feature capture/ (Feature First): service captureVisibleTab (JPEG q85),
#     stockage temporaire chrome.storage.session, hook useCapture
#   - popup: bouton capturer + aperçu + effacer (vue connectée)
#   - icones brand placeholder (icons/icon16|48|128.png) pour débloquer le build
#   - docs/capture.md; ROADMAP étape 3 cochée
#   EOF
#   )"
#   git push -u origin feat/extension-capture-ecran