# Base de données PostgreSQL
DATABASE_URL="postgresql://bugflow:bugflow@localhost:5432/bugflow?schema=public"

# Serveur
PORT=3000
NODE_ENV=development

# Origine du dashboard autorisée par le CORS (credentials)
DASHBOARD_ORIGIN=http://localhost:5173

# Secrets JWT (générer des valeurs aléatoires fortes en production)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
